APP_NAME=Agentic Research Workspace
APP_VERSION=0.1.0
ENVIRONMENT=local
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./agentic_research.db
JWT_SECRET_KEY=change-me-in-production

# ── Gemini API Key (FREE) ────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
# The key MUST start with "AIzaSy..."
# Example: GEMINI_API_KEY=AIzaSyABCDEFGHIJKLMNOPQRSTUVWXYZ1234567
GEMINI_API_KEY=AIzaSyABCDEFGHIJKLMNOPQRSTUVWXYZ1234567

LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini

# ── Optional: OpenAI ──────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Other settings ────────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
WEB_SEARCH_PROVIDER=duckduckgo
ENABLE_LANGSMITH=false
LANGSMITH_PROJECT=agentic-research-workspace
